# Copia este archivo a «.env» y rellénalo. El .env NO se sube a GitHub.

# Contraseña de acceso a ObraSec. Obligatoria al publicar en internet.
# Usa una larga: es lo único que separa tus obras del resto del mundo.
OBRASEC_PASSWORD=cambia-esto-por-algo-largo-y-tuyo

# Token del túnel de Cloudflare.
# Se obtiene en: Cloudflare Zero Trust › Networks › Tunnels › Create a tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Clave de la API de Anthropic para las funciones de IA (opcional).
# También puede configurarse desde Ajustes dentro de la propia aplicación.
ANTHROPIC_API_KEY=
